# Public application identity. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public showcase only: true disables all authentication, billing and webhooks.
# Set at both build and runtime. A complete application must use false.
DEMO_MODE=false
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DATABASE
BETTER_AUTH_SECRET=

# Creem: start in test mode. Use a separate database/configuration for live mode.
CREEM_ENVIRONMENT=test
BILLING_ENABLED=false
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_PRO_MONTHLY=
CREEM_PRODUCT_PRO_YEARLY=
CREEM_PRODUCT_LIFETIME=

# Optional email delivery. Console delivery is development-only.
RESEND_API_KEY=
EMAIL_FROM=

# Optional social login. Register /api/auth/callback/google or /github.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional analytics. Both a feature flag in starter.config.json and consent
# are required. No SDK loads on account, auth, admin or API routes.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Trust client IP headers only when your reverse proxy overwrites them.
# none | vercel | x-real-ip; configure an edge rate limit as well.
TRUSTED_PROXY=none
